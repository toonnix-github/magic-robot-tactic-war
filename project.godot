; Engine configuration file.
; Phase 2 build-your-mech prototype.

config_version=5

[application]

config/name="Magic Robot Tactic War"
run/main_scene="res://scenes/preparation_flow.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=590
window/size/window_width_override=1280
window/size/window_height_override=590
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.08, 1)
